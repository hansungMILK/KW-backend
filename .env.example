# Eureka Flows Environment Configuration
# Copy this file to .env.local and fill in your values

# Required: API endpoint for the flows backend
VITE_API_URL=http://localhost:8800

# Optional: WebSocket endpoint for real-time updates
# VITE_WS_ENDPOINT=ws://localhost:8801

# Optional: Eureka Codes console URL for API key management
# VITE_CODES_URL=https://console.eureka.codes

# Backend real-demo mode (copy these to apps/backend/.env or your shell)
ORCHESTRATOR_MODE=openai
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_ORCHESTRATOR_MODEL=gpt-5-nano
OPENAI_VISION_MODEL=gpt-5-nano
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
