STAGE=local
AWS_REGION=ap-northeast-2

# DynamoDB (local: docker run -p 8000:8000 amazon/dynamodb-local)
DYNAMODB_ENDPOINT=http://localhost:8000

# S3
S3_BUCKET=eureka-flows-local

# Orchestrator mode: mock (free local smoke), openai (real demo), or claude (legacy)
ORCHESTRATOR_MODE=openai
AI_PROVIDER=openai

# OpenAI-first demo configuration
# Cheapest current OpenAI defaults from official pricing/docs:
# - text/orchestrator/vision: gpt-5-nano
# - image generation: gpt-image-1-mini
# - TTS: tts-1 with nova voice
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_ORCHESTRATOR_MODEL=gpt-5-nano
OPENAI_VISION_MODEL=gpt-5-nano
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Legacy/optional providers. Keep empty unless switching AI_PROVIDER=legacy.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
NANOBANANA_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
