# Eureka Flows Environment Configuration
# Copy this file to .env.local and fill in your values

# Required: API endpoint for the flows backend
VITE_API_URL=http://localhost:8800

# Optional: WebSocket endpoint for real-time updates
# VITE_WS_ENDPOINT=ws://localhost:8801

# Optional: Eureka Codes console URL for API key management
# VITE_CODES_URL=https://console.eureka.codes

# Backend real-demo mode (copy these to apps/backend/.env or your shell)
# Optional locally, required for dev/prod backend deploy. Frontend users enter the same value in the API key dialog.
APP_API_KEY=
ORCHESTRATOR_MODE=openai
AI_PROVIDER=openai
ALLOW_PAID_OPENAI=false
MAX_RUN_ESTIMATED_COST_USD=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_ORCHESTRATOR_MODEL=gpt-5.4-nano
OPENAI_VISION_MODEL=gpt-5.4-nano
OPENAI_SEARCH_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_MAX_ATTEMPTS=1
OPENAI_IMAGE_SCENE_MAX_ATTEMPTS=1
OPENAI_IMAGE_SCENE_CONCURRENCY=12
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MAX_ATTEMPTS=1
WS_CALLBACK_ENDPOINT=http://localhost:8801
FFMPEG_PATH=ffmpeg
LOCAL_ASSET_BASE_URL=http://localhost:8800/_local-assets
