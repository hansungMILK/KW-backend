# Local Deployment Configuration
# Copy this file to .env.deploy and fill in your values
# This file is git-ignored for security

# AWS Configuration
AWS_PROFILE_NAME=your-profile
BUCKET_NAME=your-s3-bucket-name

# CloudFront Distribution IDs (from GitHub Secrets)
DEV_CF_DISTRIBUTION_ID=your-dev-cloudfront-id
PROD_CF_DISTRIBUTION_ID=your-prod-cloudfront-id

# Backend AI runtime
# Required for dev/prod backend. Also set GitHub secret APP_API_KEY for CI deploys.
APP_API_KEY=
ORCHESTRATOR_MODE=openai
AI_PROVIDER=openai
MAX_RUN_ESTIMATED_COST_USD=2
MAX_LONGFORM_HTML_RENDER_ESTIMATED_COST_USD=5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_ORCHESTRATOR_MODEL=gpt-5.4-nano
OPENAI_VISION_MODEL=gpt-5.4-nano
OPENAI_SEARCH_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
FFMPEG_PATH=/opt/bin/ffmpeg
LOCAL_ASSET_BASE_URL=http://localhost:8800/_local-assets
VITE_ASSET_BASE_URL=https://your-cloudfront-domain
