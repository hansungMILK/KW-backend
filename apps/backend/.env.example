STAGE=local
AWS_REGION=ap-northeast-2
WS_CALLBACK_ENDPOINT=http://localhost:8801
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=840000
FFMPEG_FONT_FILE=
SHORTS_FFMPEG_OVERLAY=all
SHORTS_BGM_MODE=catalog
SHORTS_BGM_REQUIRED=false
SHORTS_BGM_ASSETS_DIR=assets/bgm
SHORTS_BGM_VOLUME=0.07
LOCAL_ASSET_BASE_URL=http://localhost:8800/_local-assets

# DynamoDB Local is optional. Leave empty to use the built-in file store.
# DYNAMODB_ENDPOINT=http://localhost:8000
LOCAL_QUEUE_MODE=async

# S3
S3_BUCKET=eureka-flows-local

# Orchestrator mode: mock (free local smoke), openai (real demo), or claude (legacy)
# Optional in local stage. Required for dev/prod deployment so public clients cannot call protected APIs.
APP_API_KEY=
ORCHESTRATOR_MODE=openai
AI_PROVIDER=openai
ALLOW_PAID_OPENAI=false
MAX_RUN_ESTIMATED_COST_USD=2

# OpenAI-first demo configuration
# Current OpenAI defaults for the real demo:
# - text/orchestrator/vision: gpt-5.4-nano
# - image generation: gpt-image-2
# - TTS: gpt-4o-mini-tts with nova voice
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_ORCHESTRATOR_MODEL=gpt-5.4-nano
OPENAI_VISION_MODEL=gpt-5.4-nano
OPENAI_SEARCH_MODEL=gpt-5.4-nano
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_MS=120000
OPENAI_IMAGE_MAX_ATTEMPTS=1
OPENAI_IMAGE_SCENE_TIMEOUT_MS=120000
OPENAI_IMAGE_SCENE_MAX_ATTEMPTS=1
OPENAI_IMAGE_SCENE_CONCURRENCY=12
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_TIMEOUT_MS=120000
OPENAI_TTS_MAX_ATTEMPTS=1

# Legacy/optional providers. Keep empty unless switching AI_PROVIDER=legacy.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
NANOBANANA_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
