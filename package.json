{
    "name": "@flows/source",
    "version": "0.6.2",
    "license": "MIT",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "clean:cache": "npx rimraf ./node_modules/.vite ./node_modules/.cache ./.nx",
        "lint": "npx nx run-many --target=lint",
        "lint:fix": "npx nx run-many --target=lint --fix",
        "prettier": "prettier --config ./.prettierrc --write \"**/*.{js,jsx,ts,json,tsx,scss,css,html}\"",
        "prettier:staged": "prettier --config ./.prettierrc --write $(git diff --name-only --cached --diff-filter=AM | egrep '^(.*).(.ts*|.js*|.html|.json|.css|.scss)$')",
        "build:all:dev": "npx nx run-many --target=build --configuration=dev --all",
        "build:all:prod": "npx nx run-many --target=build --configuration=prod --all",
        "graph": "nx graph",
        "!web": "------------- web scripts -------------",
        "web:start": "yarn clean:cache && npx nx serve web --port 3000",
        "web:start:win": "node node_modules/nx/bin/nx.js serve web --port 3000",
        "web:build": "npx nx build web",
        "web:build:dev": "yarn clean:cache && npx nx build web -- --mode dev",
        "web:build:prod": "yarn clean:cache && npx nx build web -- --mode prod",
        "web:test": "npx nx test web",
        "web:deploy": "(rm -rf ./dist/apps/web || true) && yarn web:build:dev && ./scripts/deploy-web.sh",
        "web:deploy:dev": "(rm -rf ./dist/apps/web || true) && yarn web:build:dev && ./scripts/deploy-web.sh dev",
        "web:deploy:prod": "(rm -rf ./dist/apps/web || true) && yarn web:build:prod && ./scripts/deploy-web.sh prod",
        "e2e:ui": "playwright test tests/e2e/eureka-ui-inspection.spec.ts --project=chromium",
        "!backend": "------------- backend scripts -------------",
        "backend:start:win": "yarn workspace @flows/backend start:win",
        "backend:package:dev": "yarn workspace @flows/backend package:dev",
        "backend:deploy:dev": "yarn workspace @flows/backend deploy:dev",
        "backend:deploy:prod": "yarn workspace @flows/backend deploy:prod"
    },
    "dependencies": {
        "@aws-sdk/client-kms": "^3.1028.0",
        "@hookform/resolvers": "^3.9.1",
        "@lemoncloud/lemon-web-core": "^1.5.0",
